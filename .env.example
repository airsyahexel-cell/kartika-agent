# ============================================================
# KARTIKA-AGENT — Konfigurasi Engine AI
# Salin file ini menjadi ".env" lalu sesuaikan nilai berikut.
# Variabel lingkungan asli SELALU menimpa nilai di .env.
# ============================================================

# --- Universal Model Provider (OpenAI-Compatible) ---

# Mode Offline / Air-Gapped (Ollama lokal di server satuan):
KARTIKA_API_URL=http://localhost:11434/v1
KARTIKA_API_KEY=ollama
KARTIKA_MODEL=llama3.3

# Mode Cloud Cepat (contoh Groq) — cukup ganti tiga variabel di bawah:
# KARTIKA_API_URL=https://api.groq.com/openai/v1
# KARTIKA_API_KEY=gsk_xxxxxxxxxxxxxxxx
# KARTIKA_MODEL=llama-3.3-70b-versatile

# OpenAI:
# KARTIKA_API_URL=https://api.openai.com/v1
# KARTIKA_API_KEY=sk-xxxxxxxxxxxxxxxx
# KARTIKA_MODEL=gpt-4o-mini

# OpenRouter:
# KARTIKA_API_URL=https://openrouter.ai/api/v1
# KARTIKA_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# KARTIKA_MODEL=google/gemini-2.0-flash-001

# Gemini (endpoint OpenAI-Compatible):
# KARTIKA_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KARTIKA_API_KEY=AIzaxxxxxxxxxxxxxxxx
# KARTIKA_MODEL=gemini-2.0-flash

# vLLM lokal (air-gapped):
# KARTIKA_API_URL=http://10.10.10.5:8000/v1
# KARTIKA_API_KEY=token-vllm
# KARTIKA_MODEL=Qwen/Qwen2.5-72B-Instruct

# NVIDIA NIM (integrate.api.nvidia.com) — OpenAI-Compatible:
# KARTIKA_API_URL=https://integrate.api.nvidia.com/v1
# KARTIKA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# KARTIKA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Parameter Operasi ---
# Batas langkah penalaran ReAct per penugasan (audit menyeluruh butuh lebih banyak)
# KARTIKA_MAX_STEPS=96
# Suhu generasi (rendah = lebih deterministik utk audit)
# KARTIKA_TEMPERATURE=0.2
# Timeout koneksi ke engine (detik)
# KARTIKA_TIMEOUT=180
# Path file konfigurasi MCP
# KARTIKA_MCP_CONFIG=mcp.json
# Cakupan direktori untuk write_file
# KARTIKA_WRITE_SCOPE=.
